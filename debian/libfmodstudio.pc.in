prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib/${env:DEB_HOST_MULTIARCH}

Name: libfmodstudio
Description: FMOD Studio API
Version: ${env:DEB_VERSION_UPSTREAM}
