prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib/${env:DEB_HOST_MULTIARCH}

Name: libfmodstudioL
Description: FMOD Studio API (with logging)
Version: ${env:DEB_VERSION_UPSTREAM}
Cflags: -I${includedir}
